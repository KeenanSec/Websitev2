---
import {render} from 'astro:content';import Layout from '../../layouts/Layout.astro';import Card from '../../components/Card.astro';import {posts,url,date,reading,slug,assetAvailable,assetUrl} from '../../lib/site';
export async function getStaticPaths(){return (await posts()).map(post=>({params:{id:post.id},props:{post}}));}const {post}=Astro.props;const {Content}=await render(post);const others=(await posts()).filter(p=>p.id!==post.id);const related=others.sort((a,b)=>Number(b.data.category===post.data.category)-Number(a.data.category===post.data.category)).slice(0,2);
---
<Layout title={post.data.title} description={post.data.summary} image={post.data.cover}><article class="reading"><header class="article-heading"><a class="meta" href={url(`categories/${slug(post.data.category)}/`)}>{post.data.category}</a><h1>{post.data.title}</h1><p>{post.data.summary}</p><div class="meta"><time datetime={post.data.date.toISOString()}>{date(post.data.date)}</time> · {reading(post)} min read · Keenan Morrison</div></header>{post.data.demo&&<aside class="demo">Demonstration post — sample editorial content, not a report of completed work.</aside>}{post.data.cover&&assetAvailable(post.data.cover)&&<img class="cover" src={assetUrl(post.data.cover)} alt={post.data.coverAlt} width="1200" height="500"/>}<div class="prose"><Content/></div><div class="tags">{post.data.tags.map(tag=><span>#{tag}</span>)}</div><a class="read-link" href={url('archive/')}>← Back to archive</a></article><section class="related"><div class="section-top"><h2 class="meta">Keep reading</h2></div><div class="grid related-grid">{related.map(p=><Card post={p}/>)}</div></section></Layout>
